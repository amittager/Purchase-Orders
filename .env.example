# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local (for `next dev` / `next build`) and, if you
# also want `drizzle-kit` commands to pick up the same values, to .env.
# Never commit the real .env / .env.local files.
# ──────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get this from the Neon console → your project → "Connection string".
# Must include `?sslmode=require`.
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth.js (Auth.js) ───────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Base URL of this deployment. Used for OAuth callback construction outside Vercel.
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ── AWS S3 (uploaded price quotes + PDF approval receipts) ─────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET_NAME="your-purchase-orders-bucket"

# ── Seeding only (npm run db:seed) ──────────────────────────────────────────
# Comma-separated list of emails to insert into `allowed_approvers`. Not read
# by the app itself — only by src/db/seed.ts.
SEED_APPROVER_EMAILS="manager1@example.com,manager2@example.com"